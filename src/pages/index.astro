---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ProductCard from '../components/ProductCard.astro';
import { publishedProducts } from '../lib/products';
import site from '../data/site.json';
const products = await publishedProducts();
const featured = products.filter(item => item.data.featured).slice(0, 4);
const visibleProducts = featured.length ? featured : products.slice(0, 4);
---
<Layout overlayHeader={true}>
  <section class="hero" aria-labelledby="hero-title">
    <ResponsiveImage className="hero-image" src={site.heroImage} alt="Round concrete basin in a contemporary bathroom" sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="eyebrow-rule"></span>{site.strapline}</p>
        <h1 id="hero-title">{site.heroTitle}</h1>
        <p class="hero-description">{site.heroSubtitle}</p>
        <a class="button button--light" href="/works/">Explore collection <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-index"><span>01</span><span class="hero-index-rule"></span><span>02</span></div>
    </div>
    <a class="hero-scroll" href="#introduction">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
  </section>

  <section class="intro-section section-pad" id="introduction">
    <div class="container intro-grid">
      <p class="eyebrow eyebrow--dark">{site.introEyebrow}<span class="tiny-square" aria-hidden="true"></span></p>
      <div><h2 class="display-title intro-title">{site.introTitle}</h2><p class="intro-body">{site.introDescription}</p></div>
    </div>
  </section>

  <section class="works-section section-pad" id="selected-works">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow eyebrow--dark">{site.worksEyebrow}</p><h2 class="display-title">{site.worksTitle}</h2></div><a class="text-link" href="/works/">All works <span aria-hidden="true">↗</span></a></div>
      {visibleProducts.length ? <div class="product-grid">{visibleProducts.map((product, index) => <ProductCard product={product} index={index} />)}</div> : <p>Products will appear here soon.</p>}
    </div>
  </section>

  <section class="studio-split">
    <div class="studio-split__image"><ResponsiveImage src={site.aboutImage} alt="Oval concrete washbasin showing shape and surface texture" sizes="(max-width: 800px) 100vw, 50vw" /></div>
    <div class="studio-split__copy"><div><p class="eyebrow eyebrow--dark">{site.aboutEyebrow}</p><h2 class="display-title">{site.aboutTitle}</h2><p>{site.aboutDescription}</p><a class="text-link" href="/about/">Meet the maker <span aria-hidden="true">↗</span></a></div><span class="studio-split__number">NK — 001</span></div>
  </section>
  <section class="end-cta section-pad"><div class="container end-cta__inner"><p class="eyebrow">HAVE A PROJECT IN MIND?</p><h2 class="display-title">Beautiful objects<br /><em>begin with a conversation.</em></h2><a class="button button--outline-light" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div></section>
</Layout>
