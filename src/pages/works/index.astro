---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { publishedProducts } from '../../lib/products';
const products = await publishedProducts();
const categories = ['All', ...new Set(products.map(product => product.data.category))];
---
<Layout title="Collection" description="Explore concrete basins and sculptural objects by Nicolas Khobelia.">
  <section class="page-hero page-hero--collection"><div class="container"><p class="eyebrow eyebrow--dark">THE COLLECTION / 001</p><div class="page-hero__row"><h1 class="display-title">The collection<span class="heading-period">.</span></h1><p>A study in form, material and texture. Each piece brings its own quiet character into a space.</p></div></div></section>
  <section class="collection-section"><div class="container">
    <div class="collection-toolbar"><div class="filters" role="group" aria-label="Filter collection by shape">{categories.map((category, index) => <button type="button" class:list={['filter-button', {'is-active': index===0}]} data-filter={category} aria-pressed={index===0}>{category}</button>)}</div><span class="collection-count">{String(products.length).padStart(2, '0')} OBJECTS</span></div>
    <div class="product-grid collection-grid" id="collection-grid">{products.map((product, index) => <ProductCard product={product} index={index} />)}</div>
    <p class="filter-empty" hidden>No objects in this category yet.</p>
  </div></section>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const cards = document.querySelectorAll<HTMLElement>('.collection-grid .product-card');
  const count = document.querySelector<HTMLElement>('.collection-count');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.filter;
    let visible = 0;
    buttons.forEach(btn => { const active = btn === button; btn.classList.toggle('is-active', active); btn.setAttribute('aria-pressed', String(active)); });
    cards.forEach(card => { const show = category === 'All' || card.dataset.category === category; card.hidden = !show; if (show) visible++; });
    if (count) count.textContent = `${String(visible).padStart(2,'0')} OBJECTS`;
    if (empty) empty.hidden = visible !== 0;
  }));
</script>
</Layout>
