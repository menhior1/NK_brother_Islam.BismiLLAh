---
import site from '../data/site.json';
import {route,t,type Language} from '../lib/i18n';
const {lang}=Astro.props as {lang:Language};
const words=t(lang);
const year=new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-top">
    <a class="footer-brand" href={route(lang,'/')}>Nicolas Khobelia<span>{words.footerTag}</span></a>
    <div class="footer-links" aria-label={words.navigation}>
      <a href={route(lang,'/works/')}>{words.collection}</a><a href={route(lang,'/about/')}>{words.studio}</a><a href={route(lang,'/contact/')}>{words.contact}</a>
      {site.instagramUrl && <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
    </div>
  </div>
  <div class="container footer-bottom"><span>© {year} Nicolas Khobelia</span><span>{words.footerBottom}</span></div>
</footer>
