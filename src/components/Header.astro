---
import site from '../data/site.json';
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="brand" href="/" aria-label={`${site.brand} — home`}>
    <span class="brand-mark" aria-hidden="true">NK</span><span class="brand-name">NICOLAS<br />KHOBELIA</span>
  </a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
    <span></span><span></span>
  </button>
  <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
    <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
    <a href="/works/" aria-current={isActive('/works/') ? 'page' : undefined}>Collection</a>
    <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>The studio</a>
    <a href="/contact/" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.getElementById('primary-nav');
  if (toggle && header && nav) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      document.body.classList.toggle('nav-open', open);
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('menu-open')));
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
  }
</script>
