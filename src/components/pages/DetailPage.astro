---
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import type {CollectionEntry} from 'astro:content';
import {localized,route,t,type Language} from '../../lib/i18n';
const {lang,product}=Astro.props as {lang:Language;product:CollectionEntry<'products'>};
const {data}=product;
const words=t(lang);
const title=localized(data.title,lang);
const rows=[
  [words.material,localized(data.material,lang)],
  [words.finish,localized(data.finish,lang)],
  [words.dimensions,localized(data.dimensions,lang)]
].filter(([,value])=>Boolean(value));
---
<Layout lang={lang} title={title} description={localized(data.description,lang)} image={data.coverImage}>
  <section class="detail-section"><div class="container">
    <a class="back-link" href={route(lang,'/works/')}><span aria-hidden="true">←</span> {words.back}</a>
    <div class="detail-grid">
      <div class="detail-media"><ResponsiveImage className="detail-main-image" src={data.coverImage} alt={localized(data.alt,lang)||title} sizes="(max-width: 800px) 100vw, 62vw" loading="eager" fetchpriority="high" />{data.gallery.length>0 && <div class="detail-thumbnails">{data.gallery.map((photo,index)=><button class="detail-thumb" type="button" data-full={photo} aria-label={`${words.photo} ${index+2}`}><ResponsiveImage src={photo} alt={`${title} — ${index+2}`} sizes="140px" /></button>)}</div>}</div>
      <div class="detail-copy"><p class="eyebrow eyebrow--dark">{words.object} / {words.category[data.category]}</p><h1 class="display-title">{title}</h1><p class="detail-description">{localized(data.description,lang)}</p>{rows.length>0&&<dl class="spec-list">{rows.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}<a class="button button--dark" href={`${route(lang,'/contact/')}?product=${encodeURIComponent(title)}`}>{words.inquire} <span aria-hidden="true">↗</span></a><p class="detail-footnote">{words.availability}</p></div>
    </div>
  </div></section>
  <section class="detail-bottom"><div class="container"><p class="eyebrow eyebrow--dark">{words.discover}</p><a href={route(lang,'/works/')} class="display-title">{words.viewAll} <span aria-hidden="true">↗</span></a></div></section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.detail-thumb').forEach(button=>{
      button.addEventListener('click',()=>{
        const src=button.dataset.full;
        const picture=document.querySelector('.detail-main-image');
        const img=picture?.querySelector('img');
        if(!src||!img)return;
        picture?.querySelector('source')?.remove();
        img.src=src;
        img.alt=button.querySelector('img')?.alt||img.alt;
        document.querySelectorAll('.detail-thumb').forEach(el=>el.classList.toggle('active',el===button));
      });
    });
  </script>
</Layout>
