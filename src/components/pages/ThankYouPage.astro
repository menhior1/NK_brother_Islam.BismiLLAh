---
import Layout from '../../layouts/Layout.astro';
import {route,t,type Language} from '../../lib/i18n';
const {lang}=Astro.props as {lang:Language};const words=t(lang);
---
<Layout lang={lang} title={words.thanksTag}>
  <section class="thank-you section-pad"><div class="container"><p class="eyebrow eyebrow--dark">{words.thanksTag}</p><h1 class="display-title">{words.thanksTitle}</h1><p>{words.thanksBody}</p><a class="button button--dark" href={route(lang,'/')}>{words.returnHome} <span aria-hidden="true">↗</span></a></div></section>
</Layout>
