---
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import ProductCard from '../ProductCard.astro';
import {publishedProducts} from '../../lib/products';
import site from '../../data/site.json';
import {localized,route,t,type Language} from '../../lib/i18n';
const {lang}=Astro.props as {lang:Language};
const words=t(lang);
const products=await publishedProducts();
const featured=products.filter(p=>p.data.featured).slice(0,4);
const visibleProducts=featured.length?featured:products.slice(0,4);
---
<Layout lang={lang} overlayHeader={true}>
  <section class="hero" aria-labelledby="hero-title">
    <ResponsiveImage className="hero-image" src={site.heroImage} alt={localized(site.heroTitle,lang)} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="eyebrow-rule"></span>{localized(site.strapline,lang)}</p>
        <h1 id="hero-title">{localized(site.heroTitle,lang)}</h1>
        <p class="hero-description">{localized(site.heroSubtitle,lang)}</p>
        <a class="button button--light" href={route(lang,'/works/')}>{words.exploreCollection} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-index"><span>01</span><span class="hero-index-rule"></span><span>02</span></div>
    </div>
    <a class="hero-scroll" href="#introduction">{words.scroll} <span aria-hidden="true">↓</span></a>
  </section>
  <section class="intro-section section-pad" id="introduction">
    <div class="container intro-grid">
      <p class="eyebrow eyebrow--dark">{localized(site.introEyebrow,lang)}<span class="tiny-square" aria-hidden="true"></span></p>
      <div><h2 class="display-title intro-title">{localized(site.introTitle,lang)}</h2><p class="intro-body">{localized(site.introDescription,lang)}</p></div>
    </div>
  </section>
  <section class="works-section section-pad" id="selected-works">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow eyebrow--dark">{localized(site.worksEyebrow,lang)}</p><h2 class="display-title">{localized(site.worksTitle,lang)}</h2></div><a class="text-link" href={route(lang,'/works/')}>{words.allWorks} <span aria-hidden="true">↗</span></a></div>
      {visibleProducts.length?<div class="product-grid">{visibleProducts.map((product,index)=><ProductCard lang={lang} product={product} index={index} />)}</div>:<p>{words.soon}</p>}
    </div>
  </section>
  <section class="studio-split">
    <div class="studio-split__image"><ResponsiveImage src={site.aboutImage} alt={localized(site.aboutTitle,lang)} sizes="(max-width: 800px) 100vw, 50vw" /></div>
    <div class="studio-split__copy"><div><p class="eyebrow eyebrow--dark">{localized(site.aboutEyebrow,lang)}</p><h2 class="display-title">{localized(site.aboutTitle,lang)}</h2><p>{localized(site.aboutDescription,lang)}</p><a class="text-link" href={route(lang,'/about/')}>{words.maker} <span aria-hidden="true">↗</span></a></div><span class="studio-split__number">NK — 001</span></div>
  </section>
  <section class="end-cta section-pad"><div class="container end-cta__inner"><p class="eyebrow">{words.ctaEyebrow}</p><h2 class="display-title">{words.ctaLead}<br /><em>{words.ctaEm}</em></h2><a class="button button--outline-light" href={route(lang,'/contact/')}>{words.getInTouch} <span aria-hidden="true">↗</span></a></div></section>
</Layout>
