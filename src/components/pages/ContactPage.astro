---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { localized, t, type Language } from '../../lib/i18n';

const { lang } = Astro.props as { lang: Language };
const words = t(lang);
const phones = [
  { region: words.phoneGeorgia, number: site.contactPhoneGeorgia },
  { region: words.phoneRussia, number: site.contactPhoneRussia }
].filter(phone => phone.number);
---
<Layout lang={lang} title={words.contact} description={words.pageContactDesc}>
  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-intro">
        <p class="eyebrow eyebrow--dark">{words.contactEyebrow}</p>
        <h1 class="display-title">{localized(site.contactTitle,lang)}</h1>
        <p class="lead">{localized(site.contactDescription,lang)}</p>
        <p class="product-note" id="product-note" hidden data-prefix={words.regarding}></p>
      </div>
      <div class="contact-phones" aria-label={words.phoneContactLabel}>
        <p class="eyebrow eyebrow--dark">{words.phoneContactLabel}</p>
        {phones.map(({region, number}) => (
          <a class="contact-phone" href={`tel:${number.replace(/[^+\d]/g,'')}`} aria-label={`${words.callButton}: ${number}`}>
            <span class="contact-phone__region">{region}</span>
            <strong>{number}</strong>
            <span class="contact-phone__action">{words.callButton} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
        <p class="contact-phones__note">{words.callToDiscuss}</p>
      </div>
    </div>
  </section>
  <script>
    const product = new URLSearchParams(window.location.search).get('product');
    const note = document.querySelector<HTMLElement>('#product-note');
    if (product && note) {
      note.textContent = `${note.dataset.prefix || 'Regarding'}: ${product}`;
      note.hidden = false;
    }
  </script>
</Layout>
