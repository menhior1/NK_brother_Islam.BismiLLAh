---
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import site from '../../data/site.json';
import {localized,route,t,type Language} from '../../lib/i18n';
const {lang}=Astro.props as {lang:Language};const words=t(lang);
---
<Layout lang={lang} title={words.studio} description={words.pageAboutDesc}>
  <section class="about-page-section"><div class="container about-page-grid"><div class="about-page-text"><p class="eyebrow eyebrow--dark">{localized(site.aboutEyebrow,lang)} / {words.studio}</p><h1 class="display-title">{localized(site.aboutTitle,lang)}</h1><p class="lead">{localized(site.aboutDescription,lang)}</p><p>{words.aboutIntro}</p><a class="text-link" href={route(lang,'/contact/')}>{words.startConversation} <span aria-hidden="true">↗</span></a></div><div class="about-page-media"><ResponsiveImage src={site.aboutImage} alt={localized(site.aboutTitle,lang)} sizes="(max-width: 800px) 100vw, 50vw" loading="eager" /></div></div></section>
  <section class="about-statement"><div class="container"><p class="eyebrow eyebrow--dark">{words.aboutIdea}</p><h2 class="display-title">{words.aboutStatement}<br /><em>{words.aboutStatementEm}</em></h2></div></section>
</Layout>
