---
import { imageSrcset } from '../lib/images';
interface Props {
  src: string;
  alt: string;
  className?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, alt, className = '', sizes = '(max-width: 760px) 100vw, 50vw', loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
const srcset = import.meta.env.PROD ? imageSrcset(src) : '';
---
<picture class={className}>
  {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
  <img src={src} alt={alt} loading={loading} decoding="async" fetchpriority={fetchpriority} />
</picture>
